# PayLift backend - PRODUCTION configuration template. Placeholders only; never commit real values.
# Real values belong in the deployment's secret manager, not in the repository.
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
DATABASE_FILE=/var/lib/paylift/paylift.db

# Token signing / OTP hashing secrets (32+ random bytes each)
JWT_SECRET=
OTP_PEPPER=

# OTP delivery provider (e.g. msg91 / twilio-verify). A real adapter must be added in src/auth.js.
AUTH_PROVIDER=

# Payment gateway. A real adapter must be added in src/payments.js. Secrets stay server-side.
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Maps: MAPS_PROVIDER=google uses MAPS_SERVER_KEY (server-restricted key).
MAPS_PROVIDER=
MAPS_SERVER_KEY=

# Operator API token (refunds, manual assignment, failing rides)
ADMIN_API_TOKEN=

CANCELLATION_FEE_PAISE=0
SEARCH_TIMEOUT_SEC=120
