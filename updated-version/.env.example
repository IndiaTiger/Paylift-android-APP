# PayLift client configuration template.
#
# Copy to `.env` (git-ignored) or provide these as environment variables in CI.
# ONLY the keys listed below are compiled into the app (see app/build.gradle.kts, CLIENT_CONFIG_KEYS).
# Everything in this file ends up inside the APK, so it must only ever contain PUBLIC client values.
#
# NEVER put any of these here (they belong on the server only, see backend/.env.example):
#   payment secret keys, webhook secrets, HMAC/JWT signing keys, database credentials.

# Base URL of the PayLift backend, must be https:// for release builds. Example: https://api.example.com/
BACKEND_BASE_URL=
# Payment gateway identifier understood by the backend (e.g. razorpay). "test" is rejected for release.
PAYMENT_PROVIDER=
# Publishable/public key of the payment gateway (e.g. Razorpay key_id). NOT the key secret.
PAYMENT_PUBLIC_KEY=
# Restricted (Android-app-bound) Maps SDK key.
MAPS_API_KEY=
# Restricted Places API key (only needed if the client calls Places directly; the default design proxies through the backend).
PLACES_API_KEY=
# Restricted routing key (only needed if the client calls routing directly; the default design proxies through the backend).
ROUTING_API_KEY=
# Authentication provider identifier understood by the backend (e.g. msg91, twilio-verify). "dev" is rejected for release.
AUTH_PROVIDER=

# Debug builds only (ignored by release): local test backend. 10.0.2.2 is the host machine from the emulator.
# DEV_BACKEND_BASE_URL=http://10.0.2.2:8080/
