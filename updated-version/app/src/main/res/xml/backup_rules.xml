<?xml version="1.0" encoding="utf-8"?>
<!-- Backups are disabled (android:allowBackup="false"). Belt and braces for API < 31:
     never back up the session tokens, the cache database or preferences. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
